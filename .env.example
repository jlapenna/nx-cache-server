# Use legacy scalar tokens by default. Generate a random replacement before
# starting the server: openssl rand -hex 32
NX_CACHE_ACCESS_TOKEN=replace-with-a-random-token
NX_CACHE_READ_ONLY_ACCESS_TOKEN=

# To use per-consumer named tokens instead, set an absolute host path to a
# JSON file and leave the scalar values empty. See README.md for the format.
# NX_CACHE_TOKENS_FILE=/absolute/path/to/nx-cache-tokens.json

# Optional server overrides.
# NX_CACHE_PORT=3000
# MAX_CACHE_GB=50
# MAX_AGE_DAYS=14
