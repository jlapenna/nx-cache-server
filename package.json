{
  "name": "nx-cache-server",
  "version": "0.1.0",
  "description": "A small, dependency-free HTTP remote cache server for Nx.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "prepare": "husky",
    "lint": "nx run nx-cache-server:lint",
    "test": "nx run nx-cache-server:test",
    "verify": "nx run-many -t lint,test --projects=nx-cache-server && npm run verify:ruleset",
    "verify:ruleset": "./tools/github-ruleset-root.test.sh"
  },
  "devDependencies": {
    "@jlapenna/repo-tools": "github:jlapenna/repo-tools#main",
    "husky": "^9.1.7",
    "nx": "23.2.1"
  },
  "overrides": {
    "brace-expansion": "5.0.12"
  }
}
