{
  "version": 1,
  "inventory": "docs/interfaces.md",
  "workflows": true,
  "checks": [
    {
      "id": "native",
      "command": [
        "npm",
        "run",
        "verify"
      ]
    },
    {
      "id": "compose",
      "command": [
        "docker",
        "compose",
        "config",
        "-q"
      ]
    },
    {
      "id": "image",
      "command": [
        "docker",
        "build",
        "--tag",
        "nx-cache-server:verify",
        "apps/nx-cache-server"
      ]
    },
    {
      "id": "ownership",
      "command": [
        "docker",
        "run",
        "--rm",
        "--entrypoint",
        "/bin/sh",
        "nx-cache-server:verify",
        "-c",
        "test -r /app/server.js && test \"$(stat -c %U:%G /app/server.js)\" = node:node"
      ]
    }
  ]
}
